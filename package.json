{
  "name": "live-splits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:indexes": "tsx --env-file=.env.local scripts/setup-indexes.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "vitest run",
    "db:clear-taps": "tsx --env-file=.env.local scripts/clear-taps.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:delete-meet": "tsx --env-file=.env.local scripts/delete-meet.ts",
    "db:finish-to-split": "tsx --env-file=.env.local scripts/finish-to-split.ts",
    "db:move-result": "tsx --env-file=.env.local scripts/move-result.ts",
    "db:sheet-summaries": "tsx --env-file=.env.local scripts/sheet-summaries.ts"
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "mongodb": "^7.7.0",
    "next": "16.3.7",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
